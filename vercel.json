{
  "version": 2,
  "outputDirectory": "src/main/resources",
  "rewrites": [
    {
      "source": "/",
      "destination": "/templates/login.html"
    },
    {
      "source": "/login",
      "destination": "/templates/login.html"
    },
    {
      "source": "/register",
      "destination": "/templates/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/templates/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/static/css/:path*"
    }
  ]
}
